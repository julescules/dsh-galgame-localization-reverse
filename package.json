{
  "name": "dsh-galgame-localization-reverse",
  "version": "0.5.0",
  "description": "Galgame Doctor for DeepSeek Harness: evidence plans, lossless source-script adapters, strict translation QA, and rollback.",
  "author": "julescules",
  "homepage": "https://github.com/julescules/dsh-galgame-localization-reverse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julescules/dsh-galgame-localization-reverse.git"
  },
  "bugs": {
    "url": "https://github.com/julescules/dsh-galgame-localization-reverse/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./provider-core": "./provider-core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "provider-core.js",
    "cordis.patch.yml",
    "skill",
    "examples",
    "README.md",
    "README.zh.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/demo.svg",
    "scripts/build-release-metadata.mjs",
    "scripts/verify-release.ps1",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check provider-core.js && npm test && python -X utf8 skill/scripts/vn_project_audit.py --selftest && python -X utf8 skill/scripts/vn_script_adapter.py --selftest && python -X utf8 skill/scripts/vn_qa.py --selftest && python -X utf8 skill/scripts/vn_patch.py --selftest && python -X utf8 skill/scripts/vn_image_qa.py --selftest && python -X utf8 skill/scripts/vn_slot_qa.py --selftest",
    "pack:dry": "npm pack --dry-run",
    "release:metadata": "node scripts/build-release-metadata.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1",
    "@deepseek-ai/dsh-skill": ">=0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "galgame",
    "visual-novel",
    "translation-qa",
    "game-localization",
    "renpy",
    "kirikiri",
    "localization",
    "reverse-engineering",
    "windows",
    "rollback"
  ],
  "license": "MIT"
}
