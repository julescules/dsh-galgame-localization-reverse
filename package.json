{
  "name": "dsh-galgame-localization-reverse",
  "version": "0.3.0",
  "description": "Packaged Galgame localization and reverse-engineering skill provider for DeepSeek Harness.",
  "author": "julescules",
  "homepage": "https://github.com/julescules/dsh-galgame-localization-reverse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julescules/dsh-galgame-localization-reverse.git"
  },
  "bugs": {
    "url": "https://github.com/julescules/dsh-galgame-localization-reverse/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./provider-core": "./provider-core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "provider-core.js",
    "cordis.patch.yml",
    "skill",
    "README.md",
    "README.zh.md",
    "docs/demo.svg",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check provider-core.js && npm test && python -X utf8 skill/scripts/vn_qa.py --selftest && python -X utf8 skill/scripts/vn_patch.py --selftest && python -X utf8 skill/scripts/vn_image_qa.py --selftest && python -X utf8 skill/scripts/vn_slot_qa.py --selftest",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1",
    "@deepseek-ai/dsh-skill": ">=0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "galgame",
    "visual-novel",
    "localization",
    "reverse-engineering",
    "windows",
    "rollback"
  ],
  "license": "MIT"
}
